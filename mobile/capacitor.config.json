{
  "appId": "pk.com.pgbx.app",
  "appName": "PGBX",
  "webDir": "../dist",
  "backgroundColor": "#0B4A2C",
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": []
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
