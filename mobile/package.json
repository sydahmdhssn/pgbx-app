{
  "name": "pgbx-mobile",
  "private": true,
  "description": "PGBX iOS and Android apps (Capacitor) around the production build in ../dist",
  "scripts": {
    "build:web": "npm --prefix .. run build:app",
    "sync": "npm run build:web && cap sync",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-native-biometric": "^8.7.0",
    "capacitor-secure-storage-plugin": "^0.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
