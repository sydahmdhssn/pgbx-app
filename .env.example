# PGBX environment variables. Real values live in Vercel (Project, Settings,
# Environment Variables), never in the code or in git. For local checks, pull
# them with `vercel env pull .env.production` and pass the file with
# `node --env-file=.env.production ...`; .env files are git ignored.
# Everything here is SERVER ONLY: nothing is bundled into the app or web pages.
# Run `npm run launch:check` against the production values before going live.

# ---- Database ------------------------------------------------------------------

# PostgreSQL connection. On Supabase use the pooled connection string (port 6543).
# Required: without it the API answers "not connected".
DATABASE_URL=

# Protects the scheduled sweep (expiries, reminders, purge). Vercel sends it to
# the cron automatically. Required: without it the sweep is refused.
CRON_SECRET=

# ---- Login codes (Twilio Verify) ----------------------------------------------

# Twilio account and the production Verify service. Required in production:
# without them nobody can log in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Separate Verify service used only by the demo at / (api/otp.mjs), never
# production's. Optional: the demo stays in demo mode without it.
TWILIO_DEMO_VERIFY_SERVICE_SID=

# Set to 1 to add WhatsApp codes, only once a WhatsApp Business sender is
# connected to the Verify service. Optional.
# OTP_WHATSAPP=1

# Set to 1 to let the demo at / send real SMS codes (also needs the demo Verify
# service). Optional. Leave unset in production.
# OTP_DEMO_SMS=1

# Store review login while Apple or Google review the app:
# <number without 0 or +92>:<6 digit code>:<last day YYYY-MM-DD>.
# Optional. Remove it once the review is approved.
# REVIEW_LOGIN=

# ---- Human check (Cloudflare Turnstile) ---------------------------------------

# Site key (shown to the browser by the API) and secret. Optional but strongly
# recommended: without them bots can request login codes, and each costs an SMS.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---- Payments and identity checks ---------------------------------------------

# Payment provider name and its webhook signing secret. Required in production:
# without them customers cannot pay.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# Identity verification provider and its webhook signing secret. Required in
# production: without them nobody can be verified to buy.
KYC_PROVIDER=
KYC_WEBHOOK_SECRET=

# ---- Push notifications -------------------------------------------------------

# Firebase service account JSON (one line) for push to Android and iOS.
# Optional: without it notifications stay inside the app.
FCM_SERVICE_ACCOUNT=

# Build time only (npm run build:app): platforms whose push setup is complete,
# comma separated, e.g. android,ios. Optional: empty means push stays off.
PGBX_PUSH=

# ---- Site access --------------------------------------------------------------

# Password screen in front of the whole website. Optional: site open when unset.
SITE_PASSWORD=

# ---- Test modes: NEVER in production ------------------------------------------
# OTP_TEST_MODE=1 lets code 123456 log anyone in. PAYMENT_PROVIDER=sandbox and
# KYC_PROVIDER=sandbox make payments and checks always pass. ALLOW_SANDBOX=1
# allows sandbox funds on the production deployment.
# OTP_TEST_MODE=1
# ALLOW_SANDBOX=1

# ---- Local development only ---------------------------------------------------
# Used by `npm run dev` and the tests, not on Vercel.
# PORT=8080
# HOST=127.0.0.1
# RATE_CHAT=0                  instant prices without the final rate chat (dev seed)
# TEST_POSTGRES_URL=           run the tests against a real Postgres instead of PGlite

# Set by Vercel and Node automatically; do not set by hand: VERCEL_ENV, NODE_ENV.
